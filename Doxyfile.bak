PROJECT_NAME           = "NUControl"
PROJECT_BRIEF          = "Field-Oriented Control library for iMXRT1062 (Teensy 4.x) with center-aligned PWM and DMA ADC"
OUTPUT_DIRECTORY       = docs/
INPUT                  = src/
FILE_PATTERNS          = *.hpp *.cpp *.h
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
CLASS_DIAGRAMS         = YES
TEMPLATE_RELATIONS     = YES
USE_MATHJAX            = YES
MATHJAX_FORMAT         = HTML-CSS
WARN_NO_PARAMDOC       = YES
WARN_IF_UNDOCUMENTED   = YES
PREDEFINED             = ARDUINO=1 \
                         __IMXRT1062__=1
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
QUIET                  = NO
WARNINGS               = YES
